{% extends "layout.njk" %}

{% block content %}
  <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <p class="page-kicker text-primary fw-semibold mb-1">Cadastro</p>
      <h1 class="h3 fw-bold mb-0">Animal</h1>
    </div>
    <a class="btn btn-outline-secondary" href="/animal">
      <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
  </header>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmAnimal" data-servidor-dw3="{{ servidorTrabalho }}">
        <input type="hidden" id="idAnimal" name="idAnimal">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-md-8">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" maxlength="100" required>
          </div>
          <div class="col-md-4">
            <label for="datanasc" class="form-label">Data de nascimento</label>
            <input type="date" class="form-control" id="datanasc" name="datanasc">
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="btnInserirAnimal" class="btn btn-primary d-none">
            <i class="bi bi-check-lg me-1"></i>Inserir
          </button>
          <button type="button" id="btnAtualizarAnimal" class="btn btn-warning d-none">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" id="btnRemoverAnimal" class="btn btn-danger d-none">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/animal/vwFormAnimal.js"></script>
{% endblock %}
