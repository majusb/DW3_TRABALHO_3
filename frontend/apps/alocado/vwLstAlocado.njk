{% extends "layout.njk" %}

{% block content %}
  <div id="alocadoListagem" data-servidor-dw3="{{ servidorTrabalho }}">
    <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <p class="page-kicker text-primary fw-semibold mb-1">Pastejo</p>
        <h1 class="h3 fw-bold mb-0">Alocações</h1>
      </div>
      <a class="btn btn-primary" href="/alocado/form?oper=Cr">
        <i class="bi bi-plus-lg me-1"></i>Nova alocação
      </a>
    </header>

    <div id="alocadoAlert" class="alert d-none" role="alert"></div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <table id="tblAlocado" class="table table-striped table-hover align-middle w-100">
          <thead>
            <tr>
              <th>ID</th>
              <th>Animal</th>
              <th>Piquete</th>
              <th>Início</th>
              <th>Fim</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/alocado/vwLstAlocado.js"></script>
{% endblock %}
