{% extends "layout.njk" %}

{% block content %}
  <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <p class="page-kicker text-primary fw-semibold mb-1">Pastejo</p>
      <h1 class="h3 fw-bold mb-0">Alocação</h1>
    </div>
    <a class="btn btn-outline-secondary" href="/alocado">
      <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
  </header>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmAlocado" data-servidor-dw3="{{ servidorTrabalho }}">
        <input type="hidden" id="idAlocado" name="idAlocado">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-md-6">
            <label for="animalidifk" class="form-label">Animal</label>
            <select class="form-select" id="animalidifk" name="animalidifk" required>
              <option value="">Selecione o animal</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="piqueteidfk" class="form-label">Piquete</label>
            <select class="form-select" id="piqueteidfk" name="piqueteidfk" required>
              <option value="">Selecione o piquete</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="datainicio" class="form-label">Data de início</label>
            <input type="date" class="form-control" id="datainicio" name="datainicio" required>
          </div>
          <div class="col-md-6">
            <label for="datafinal" class="form-label">Data final</label>
            <input type="date" class="form-control" id="datafinal" name="datafinal">
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="btnInserirAlocado" class="btn btn-primary d-none">
            <i class="bi bi-check-lg me-1"></i>Inserir
          </button>
          <button type="button" id="btnAtualizarAlocado" class="btn btn-warning d-none">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" id="btnRemoverAlocado" class="btn btn-danger d-none">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/alocado/vwFormAlocado.js"></script>
{% endblock %}
