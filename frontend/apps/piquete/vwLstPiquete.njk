{% extends "layout.njk" %}

{% block content %}
  <div id="piqueteListagem" data-servidor-dw3="{{ servidorTrabalho }}">
    <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <p class="page-kicker text-primary fw-semibold mb-1">Gerenciamento</p>
        <h1 class="h3 fw-bold mb-0">Piquetes</h1>
      </div>
      <a class="btn btn-primary" href="/piquete/form?oper=Cr">
        <i class="bi bi-plus-lg me-1"></i>Novo piquete
      </a>
    </header>

    <div id="piqueteAlert" class="alert d-none" role="alert"></div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <table id="tblPiquete" class="table table-striped table-hover align-middle w-100">
          <thead>
            <tr>
              <th>ID</th>
              <th>Descrição</th>
              <th>Latitude</th>
              <th>Longitude</th>
              <th>Pasto (ID)</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/piquete/vwLstPiquete.js"></script>
{% endblock %}