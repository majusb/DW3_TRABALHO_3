{% extends "layout.njk" %}

{% block content %}
  <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <p class="page-kicker text-primary fw-semibold mb-1">Gerenciamento</p>
      <h1 class="h3 fw-bold mb-0">Piquete</h1>
    </div>
    <a class="btn btn-outline-secondary" href="/piquete">
      <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
  </header>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmPiquete" data-servidor-dw3="{{ servidorTrabalho }}">
        <input type="hidden" id="idPiquete" name="idPiquete">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-md-6">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" placeholder="Ex: Piquete Norte 01" required maxlength="100">
          </div>

          <div class="col-md-6">
            <label for="pastoidfk" class="form-label">Pasto</label>
            <select class="form-select" id="pastoidfk" name="pastoidfk" required>
              <option value="">Selecione o pasto</option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="latitude" class="form-label">Latitude</label>
            <input type="number" step="any" class="form-control" id="latitude" name="latitude" placeholder="Ex: -20.8113">
          </div>

          <div class="col-md-6">
            <label for="longitude" class="form-label">Longitude</label>
            <input type="number" step="any" class="form-control" id="longitude" name="longitude" placeholder="Ex: -49.3758">
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="btnInserirPiquete" class="btn btn-primary d-none">
            <i class="bi bi-check-lg me-1"></i>Inserir
          </button>
          <button type="button" id="btnAtualizarPiquete" class="btn btn-warning d-none">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" id="btnRemoverPiquete" class="btn btn-danger d-none">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/piquete/vwFormPiquete.js"></script>
{% endblock %}