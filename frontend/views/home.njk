{% extends "layout.njk" %}

{% block content %}
  <header class="page-header mb-4">
    <p class="page-kicker text-primary fw-semibold mb-2">Sistema de pastejo rotacionado</p>
    <h1 class="display-6 fw-bold mb-2">Painel principal</h1>
    <p class="text-secondary mb-0">Use a navegação superior para acessar os cadastros.</p>
  </header>

  <div class="row g-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <h2 class="h5 fw-semibold mb-2"><i class="bi bi-piggy-bank me-2"></i>Animais</h2>
          <p class="text-secondary">Cadastro e consulta dos animais.</p>
          <a class="btn btn-primary" href="/animal">Abrir</a>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <h2 class="h5 fw-semibold mb-2"><i class="bi bi-signpost-2 me-2"></i>Alocações</h2>
          <p class="text-secondary">Animais alocados nos piquetes por período.</p>
          <a class="btn btn-primary" href="/alocado">Abrir</a>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <h2 class="h5 fw-semibold mb-2"><i class="bi bi-grid me-2"></i>Pastos</h2>
          <p class="text-secondary">Cadastro e consulta dos pastos.</p>
          <a class="btn btn-primary" href="/pasto">Abrir</a>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <h2 class="h5 fw-semibold mb-2"><i class="bi bi-geo-alt me-2"></i>Piquetes</h2>
          <p class="text-secondary">Cadastro e consulta dos piquetes.</p>
          <a class="btn btn-primary" href="/piquete">Abrir</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}