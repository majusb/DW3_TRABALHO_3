{% extends "layout.njk" %}

{% block content %}
  <header class="page-header mb-4">
    <p class="page-kicker text-primary fw-semibold mb-2">Sistema de pastejo rotacionado</p>
    <h1 class="display-6 fw-bold mb-2">Painel principal</h1>
    <p class="text-secondary mb-0">Use a navegação lateral para acessar os cadastros.</p>
  </header>

  <div class="row g-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card home-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <span class="icon-circle mb-3"><i class="bi bi-piggy-bank"></i></span>
          <h2 class="h5 fw-semibold mb-2">Animais</h2>
          <p class="text-secondary">Cadastro e consulta dos animais.</p>
          <a class="btn btn-primary" href="/animal">Abrir <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card home-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <span class="icon-circle mb-3"><i class="bi bi-signpost-2"></i></span>
          <h2 class="h5 fw-semibold mb-2">Alocações</h2>
          <p class="text-secondary">Animais alocados nos piquetes por período.</p>
          <a class="btn btn-primary" href="/alocado">Abrir <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card home-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <span class="icon-circle mb-3"><i class="bi bi-grid"></i></span>
          <h2 class="h5 fw-semibold mb-2">Pastos</h2>
          <p class="text-secondary">Cadastro e consulta dos pastos.</p>
          <a class="btn btn-primary" href="/pasto">Abrir <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card home-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <span class="icon-circle mb-3"><i class="bi bi-geo-alt"></i></span>
          <h2 class="h5 fw-semibold mb-2">Piquetes</h2>
          <p class="text-secondary">Cadastro e consulta dos piquetes.</p>
          <a class="btn btn-primary" href="/piquete">Abrir <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
