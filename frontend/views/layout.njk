<!-- views/layout.njk - molde das telas: barra lateral (sidebar), tema verde, Bootstrap e DataTables -->
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'Pastejo Rotacionado' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="app-shell">
  {% if showNavbar %}
    <div class="app-layout">
      <aside class="app-sidebar">
        <a class="sidebar-brand" href="/home"><i class="bi bi-tree-fill"></i> Pastejo</a>
        <nav class="sidebar-nav">
          <a href="/animal" class="{% if activeMenu == 'Animal' %}active{% endif %}"><i class="bi bi-piggy-bank"></i> Animais</a>
          <a href="/alocado" class="{% if activeMenu == 'Alocado' %}active{% endif %}"><i class="bi bi-signpost-2"></i> Alocações</a>
          <a href="/pasto" class="{% if activeMenu == 'Pasto' %}active{% endif %}"><i class="bi bi-grid"></i> Pastos</a>
          <a href="/piquete" class="{% if activeMenu == 'Piquete' %}active{% endif %}"><i class="bi bi-geo-alt"></i> Piquetes</a>
        </nav>
        <a class="sidebar-sair" href="#" onclick="dw3ClearIsLoggedCookie(); window.location.href='/login'; return false;"><i class="bi bi-box-arrow-right"></i> Sair</a>
      </aside>
      <div class="app-content">
        <div class="content-inner">
          {% block content %}{% endblock %}
        </div>
      </div>
    </div>
  {% else %}
    <main class="login-wrap">
      <div class="container py-5">
        {% block content %}{% endblock %}
      </div>
    </main>
  {% endif %}

  <!-- Bibliotecas comuns a todas as telas, carregadas ANTES dos scripts de cada página -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/frontend.js"></script>

  {% block scripts %}{% endblock %}
</body>
</html>
